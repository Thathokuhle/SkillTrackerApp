@using SkillTrackerApp.ViewModels
@model Skill;

@{
    ViewData["Title"] = "Add New Skill";
}

<div class="skill-container mt-3">
    <div class="skill-box">
        <h2 class="text-center">Create</h2>

<form asp-action="Create" method="post">
            <div class="form-group mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

            <div class="form-group mb-3">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
            <div class="form-group">
                <input type="submit" value="Add Skill" class="btn btn-success w-100 p-2" />
                <div class="text-center">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none mt-3" />Back</a>
            </div>
            </div>
</form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}