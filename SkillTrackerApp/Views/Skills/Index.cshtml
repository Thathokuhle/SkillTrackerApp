@model IEnumerable<SkillTrackerApp.Models.Skill>
@{
    ViewData["Title"] = "My Skills";
}

<div class="container mt-5">

    <!-- Header + Add Skill -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-book me-2"></i> My Skills</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus me-1"></i> Add Skill
        </a>
    </div>

    <!-- Search & Filter -->
    <form method="get" class="mb-4">
        <div class="row g-2">
            <div class="col-md-6">
                <input type="text" name="searchQuery" value="@ViewBag.SearchQuery" class="form-control" placeholder="Search skills...">
            </div>
            <div class="col-md-4">
                <select name="categoryFilter" class="form-select">
                    <option value="">All Categories</option>
                    <option value="Coding">Coding</option>
                    <option value="Design">Design</option>
                    <option value="Soft Skills">Soft Skills</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-1"></i> Search
                </button>
            </div>
        </div>
    </form>

    <!-- No Skills Message -->
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <strong>No skills added yet.</strong> Click the "Add Skill" button to create your first one.
        </div>
    }
    else
    {
        <!-- Card Grid Layout -->
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var skill in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@skill.Name</h5>
                            <p class="card-text text-muted flex-grow-1">@skill.Description</p>
                        </div>
                        <div class="card-footer d-flex justify-content-between">
                            <a asp-action="Details" asp-route-id="@skill.Id" class="btn btn-sm btn-info me-1">
                                <i class="bi bi-eye"></i> View
                            </a>
                            <div>
                                <a asp-action="Update" asp-route-id="@skill.Id" class="btn btn-sm btn-warning me-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@skill.Id" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
