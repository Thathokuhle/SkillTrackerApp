@model IEnumerable<SkillTrackerApp.Models.Skill>
@{
    ViewData["Title"] = "My Skills";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Skills</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add New Skill
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <strong>No skills added yet.</strong> Click the "Add New Skill" button to create your first one.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th class="text-center" style="width: 180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var skill in Model)
                {
                    <tr>
                        <td>@skill.Name</td>
                        <td>@skill.Description</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@skill.Id" class="btn btn-sm btn-info me-1">
                                <i class="bi bi-eye"></i> View
                            </a>
                            <a asp-action="Edit" asp-route-id="@skill.Id" class="btn btn-sm btn-warning me-1">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@skill.Id" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>