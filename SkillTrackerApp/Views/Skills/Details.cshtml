@model SkillTrackerApp.Models.Skill

@{
    ViewData["Title"] = "Skill Details";
}

<h2 class="mb-4">Skill Details</h2>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.Name</h4>
        <p class="card-text">
            <strong>Description:</strong> @Model.Description
        </p>
    </div>
    <div class="card-footer d-flex flex-row">
        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning m-2">
            <i class="fas fa-edit"></i> Edit
        </a>

        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger m-2">
            <i class="fas fa-trash-alt"></i> Delete
        </a>

        <a asp-controller="Goals" asp-action="Index" asp-route-skillId="@Model.Id" class="btn btn-sm btn-info me-1">
            <i class="fas fa-bullseye"></i> View Goals
        </a>

        <a asp-action="Index" class="btn btn-secondary m-2">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>

    </div>
</div>
