@model SkillTrackerApp.Models.LearningGoal

@{
    ViewData["Title"] = "Update Goal";
}

<h2 class="mb-4">Update Learning Goal</h2>

<form asp-action="Update" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="GoalTitle" class="form-label"></label>
        <input asp-for="GoalTitle" class="form-control" />
        <span asp-validation-for="GoalTitle" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TargetDate" class="form-label"></label>
        <input asp-for="TargetDate" class="form-control" type="date" />
        <span asp-validation-for="TargetDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SkillId" class="form-label">Select Skill</label>
        <select asp-for="SkillId" class="form-select"
                asp-items="@(new SelectList(ViewBag.Skills, "Id", "Name"))">
            <option value="">-- Select Skill --</option>
        </select>
        <span asp-validation-for="SkillId" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsCompleted" class="form-check-input" />
        <label asp-for="IsCompleted" class="form-check-label">Mark as Completed</label>
    </div>

    <!-- NEW: Progress Slider -->
    <div class="mb-3">
        <label for="progressRange" class="form-label">Progress: @Model.ProgressPercentage%</label>
        <input type="range" id="progressRange" name="ProgressPercentage" min="0" max="100" value="@Model.ProgressPercentage" class="form-range" />
    </div>

    <button type="submit" class="btn btn-primary">Update Goal</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
