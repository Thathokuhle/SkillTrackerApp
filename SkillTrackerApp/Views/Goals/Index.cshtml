@model IEnumerable<SkillTrackerApp.Models.DTOs.LearningGoalDto>

@{
    ViewData["Title"] = "Learning Goals";
}

<div class="container mt-5">
<div class="d-flex justify-content-between align-items-center mb-4">
<h2 class="mb-4">
    @if (ViewBag.SkillId != null)
    {
        <span>Goals for Skill: @Model.FirstOrDefault()?.SkillName</span>
    }
    else
    {
        <span>All Learning Goals</span>
    }
</h2>
        <a asp-action="Create" class="btn btn-primary mb-3">Add New Goal</a>
</div>

 @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <strong>No Goals added yet.</strong> Click the "Add New Goal" button to create your first one.
        </div>
    }
    else
    {
<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <div class="card p-3">
<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchQuery" value="@ViewBag.SearchQuery" class="form-control" placeholder="Search goals...">
        <button class="btn btn-success" type="submit">Search</button>
    </div>
</form>

<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th>Goal Title</th>
            <th>Skill</th>
            <th>Target Date</th>
            <th>Status</th>
            <th>Progress</th>
            <th style="width: 200px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var goal in Model)
        {
            <tr>
                <td>@goal.GoalTitle</td>
                <td>@goal.SkillName</td>
                <td>@goal.TargetDate.ToString("yyyy-MM-dd")</td>
                <td>
                    @if (goal.IsCompleted)
                    {
                        <span class="badge bg-success">Completed</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">In Progress</span>
                    }
                </td>
                <td>
                    <div class="progress" style="height: 20px;">
                        <div class="progress-bar @(goal.IsCompleted ? "bg-success" : "bg-info")"
                             role="progressbar"
                             style="width:@goal.ProgressPercentage%">
                            @goal.ProgressPercentage%
                        </div>
                    </div>
                </td>
                <td>
                    <a asp-action="Update" asp-route-id="@goal.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@goal.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
            </div>
        </div>
    </div>
</div>
}
