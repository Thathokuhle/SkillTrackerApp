@model SkillTrackerApp.Models.DashboardViewModel

@{
    ViewData["Title"] = "Progress Dashboard";
}


<div class="container my-4">
    <h2 class="mb-4 text-left fw-bold">📊 Progress Dashboard</h2>

    <!-- Row for Chart -->
    <div class="row mb-4">
        <div class="col-12 col-md-4 offset-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <canvas id="progressChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Completed Goals -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Completed Goals</h5>
                </div>
                <div class="card-body">
                    @if (Model.CompletedGoals.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var goal in Model.CompletedGoals)
                            {
                                <div class="list-group-item d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                                    <div class="mb-2 mb-md-0">
                                        <strong>@goal.GoalTitle</strong>
                                        <span class="text-muted"> - @goal.ProgressPercentage%</span>
                                    </div>
                                    <form asp-action="UpdateGoalProgress" method="post" class="d-flex align-items-center gap-2">
                                        <input type="hidden" name="goalId" value="@goal.Id" />
                                        <input type="range" name="progress" min="0" max="100"
                                               value="@goal.ProgressPercentage" class="form-range"
                                               onchange="this.form.submit()" />
                                    </form>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No active goals at the moment.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Active Goals -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Active Goals</h5>
                </div>
                <div class="card-body">
                    @if (Model.ActiveGoals.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var goal in Model.ActiveGoals)
                            {
                                <div class="list-group-item d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                                    <div class="mb-2 mb-md-0">
                                        <strong>@goal.GoalTitle</strong>
                                        <span class="text-muted"> - @goal.ProgressPercentage%</span>
                                    </div>
                                    <form asp-action="UpdateGoalProgress" method="post" class="d-flex align-items-center gap-2">
                                        <input type="hidden" name="goalId" value="@goal.Id" />
                                        <input type="range" name="progress" min="0" max="100"
                                               value="@goal.ProgressPercentage" class="form-range"
                                               onchange="this.form.submit()" />
                                    </form>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No active goals at the moment.</p>
                    }
                </div>
            </div>
        </div>
    </div>



</div>

<!-- Chart.js Script -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('progressChart').getContext('2d');
    const chart = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['Completed', 'In Progress'],
            datasets: [{
                data: [@Model.CompletedCount, @Model.InProgressCount],
                backgroundColor: ['#4caf50', '#ff9800'],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: { font: { size: 14 } }
                }
            }
        }
    });
</script>
