@model SkillTrackerApp.Models.DashboardViewModel

@{
    ViewData["Title"] = "Progress Dashboard";
}

@using Microsoft.AspNetCore.Identity
@inject UserManager<SkillTrackerApp.Models.Users> UserManager

@{
    ViewData["Title"] = "Dashboard";
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.FullName ?? currentUser?.UserName ?? "User";
}


<div class="container my-4">
    <h2 class="mb-4 text-left fw-bold">📊 Progress Dashboard</h2>

    <!-- Summary Cards -->
    <div class="row my-4">
        <div class="col-12 col-md-4 mb-3">
            <div class="card shadow-sm text-center p-3">
                <i class="fas fa-book fa-2x mb-2 text-primary"></i>
                <h5>Total Skills</h5>
                <h3>@Model.TotalSkills</h3>
            </div>
        </div>
        <div class="col-12 col-md-4 mb-3">
            <div class="card shadow-sm text-center p-3">
                <i class="fas fa-bullseye fa-2x mb-2 text-success"></i>
                <h5>Total Goals</h5>
                <h3>@Model.TotalGoals</h3>
            </div>
        </div>
        <div class="col-12 col-md-4 mb-3">
            <div class="card shadow-sm text-center p-3">
                <i class="fas fa-check fa-2x mb-2 text-warning"></i>
                <h5>Completed Goals</h5>
                <h3>@Model.CompletedGoals</h3>
            </div>
        </div>
    </div>

    <!-- Progress Chart -->
    <div class="row mb-4">
        <div class="col-12 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-chart-pie me-2"></i> Goal Progress</h5>
                    <canvas id="progressChart"></canvas>
                </div>
            </div>
        </div>

    <!-- Recent Activity -->
            <div class="col-12 col-md-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-history me-2"></i> Recent Activity</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentActivities.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var activity in Model.RecentActivities)
                            {
                                <li class="list-group-item">
                                    <strong>@activity.Title</strong>
                                    <span class="text-muted">(@activity.Date.ToString("yyyy-MM-dd"))</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-center text-muted">No recent activity.</div>
                    }
                </div>
            </div>
        </div>
    </div>
    



</div>

<!-- Chart.js Script -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('progressChart').getContext('2d');
    const chart = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['Completed', 'In Progress'],
            datasets: [{
                data: [@Model.CompletedCount, @Model.InProgressCount],
                backgroundColor: ['#4caf50', '#ff9800'],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: { font: { size: 14 } }
                }
            }
        }
    });
</script>
